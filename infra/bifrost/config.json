{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": { "enabled": false },
  "logs_store": { "enabled": true, "type": "sqlite", "config": { "path": "./logs.db" } },
  "client": { "drop_excess_requests": false },
  "providers": {
    "ollama": {
      "keys": [
        { "name": "local-ollama", "value": "", "models": ["qwen2.5:7b-instruct", "llama3.1:8b", "nomic-embed-text"], "weight": 1.0,
          "ollama_key_config": { "url": "http://host.docker.internal:11434" } }
      ],
      "network_config": {
        "base_url": "http://host.docker.internal:11434",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 1,
        "allow_private_network": true
      }
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "otel",
      "config": {
        "service_name": "bifrost-gateway",
        "collector_url": "http://langfuse-web:3000/api/public/otel/v1/traces",
        "trace_type": "genai_extension",
        "protocol": "http",
        "headers": { "Authorization": "env.LANGFUSE_OTEL_AUTH" }
      }
    }
  ]
}
