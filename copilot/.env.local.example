# Copy to .env.local (loaded by scripts/run.sh). Never commit .env.local.
# Without this file the app talks straight to Ollama with no tracing.

# --- Option B: models through Bifrost (infra/bifrost) ---
SETTINGS_PROFILE=gateway
BIFROST_URL=http://127.0.0.1:8080/v1
GATEWAY_API_KEY=local
# Optional: embeddings straight to Ollama if Bifrost does not proxy them
EMBED_BASE_URL=

# --- Tracing: self-hosted Langfuse ONLY (never a cloud host) ---
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- App ---
APP_PORT=8000
