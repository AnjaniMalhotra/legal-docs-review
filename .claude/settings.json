{
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lines)",
      "Bash(make smoke)",
      "Bash(make logs)",
      "Bash(python3 scripts/check_line_limits.py:*)",
      "Bash(python3 copilot/scripts/check_line_limits.py:*)",
      "Bash(.venv-test/bin/python -m pytest:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(./copilot/data/**)",
      "Read(/copilot/data/**)",
      "Read(./copilot/.env)",
      "Read(/copilot/.env)",
      "Bash(cat copilot/.env)",
      "Bash(cat .env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_line_limit.py\""
          }
        ]
      }
    ]
  }
}
